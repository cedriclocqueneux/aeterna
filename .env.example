# Yerel geliştirme şablonu — kopyalayın: cp .env.example .env
# Backend: set -a && source .env && set +a && cd backend && go run ./cmd/server --encryption-key-file=../secrets/encryption_key

ENV=development
DATABASE_PATH=./data/aeterna.db
DB_ENCRYPTION_ENABLED=false
DB_ENCRYPTION_AUTO_MIGRATE=true
# Fixed path expected by install.sh and backend runtime.
DB_ENCRYPTION_KDF_CONTEXT_FILE=./secrets/db_kdf_context
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BASE_URL=http://localhost:5173
AUTH_SESSION_TTL_HOURS=12
LOG_LEVEL=info

# Optionnel — inscription supplémentaire : via variable d’environnement OU en activant “Allow registration” dans les Paramètres
# ALLOW_REGISTRATION=true
# MASTER_PASSWORD=
# WEBHOOK_ALLOWLIST_HOSTS=
# LOG_FORMAT=json
# LOG_FILE=

# Optionnel — Plausible Analytics (laisser vide pour désactiver)
# PLAUSIBLE_DOMAIN=app.exemple.fr          # Domaine suivi dans Plausible (ex: app.un-dernier-message.fr)
# PLAUSIBLE_URL=https://plausible.exemple.fr  # URL de votre instance Plausible

# Optionnel — Brevo mailing list (laisser vide pour désactiver)
# Si renseigné : une case à cocher RGPD apparaît lors de l'inscription.
# Les utilisateurs qui cochent sont ajoutés automatiquement à la liste Brevo.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxx       # Clé API Brevo (Settings > API Keys)
# BREVO_LIST_ID=3                          # ID de la liste de contacts Brevo
